{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unparalleledsource.com/schemas/hiveforge-agent-package.schema.json",
  "title": "HiveForge Agent Package",
  "type": "object",
  "required": ["schema_version", "agent", "startup", "security"],
  "properties": {
    "schema_version": { "type": "string" },
    "agent": {
      "type": "object",
      "required": ["id", "name", "version", "status", "owner"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "enum": ["experimental", "candidate", "production", "deprecated"] },
        "owner": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "startup": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "capabilities": { "type": "object" },
    "workflows": { "type": "array", "items": { "type": "string" } },
    "skills": { "type": "array", "items": { "type": "string" } },
    "connectors": { "type": "object" },
    "dependencies": { "type": "object" },
    "output_schemas": { "type": "array", "items": { "type": "string" } },
    "evaluations": { "type": "array", "items": { "type": "string" } },
    "security": {
      "type": "object",
      "required": ["secrets_in_package", "least_privilege", "public_safe"],
      "properties": {
        "secrets_in_package": { "const": false },
        "least_privilege": { "const": true },
        "public_safe": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": false
}

